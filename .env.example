# Server-only configuration. Keep demo mode unless a separately reviewed live integration exists.
PAYMENTS_MODE=demo
NODE_ENV=development
PORT=8787

# PostgreSQL connections. Keep DATABASE_MIGRATION_URL separate from the runtime
# DATABASE_URL role; never use a superuser/BYPASSRLS role for application requests.
DATABASE_URL=
DATABASE_MIGRATION_URL=
# Set to "require" in production so PostgreSQL TLS certificates are verified.
DATABASE_SSL=

# Production prerequisites only. Leave empty in this demo; never prefix these with VITE_.
MP_CREDENTIALS_ENV=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
PUBLIC_BASE_URL=
MP_WEBHOOK_URL=
MP_SUCCESS_URL=
MP_FAILURE_URL=
MP_PENDING_URL=

# Set only after production webhook setup and security review are completed.
MP_WEBHOOK_PAYMENTS_EVENT_ENABLED=false
MP_WEBHOOK_VALIDATED=false
PAYMENTS_SECURITY_REVIEWED=false
